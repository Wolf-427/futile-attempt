{
  "name": "scriptum",
  "productName": "Scriptum",
  "version": "2.0.0-dev.1",
  "description": "A writing app with spatial canvas boards",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "probe": "node scripts/probe.mjs",
    "cloud-check": "vitest run --config vitest.cloud.config.mts",
    "test:e2e": "electron-vite build && playwright test",
    "check": "npm run typecheck && npm run test && npm run test:e2e",
    "dist": "electron-vite build && electron-builder --mac"
  },
  "build": {
    "appId": "com.wolf427.scriptum",
    "productName": "Scriptum",
    "files": [
      "out/**/*",
      "assets/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.productivity"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  }
}
