{
  "name": "scriptum",
  "productName": "Scriptum",
  "version": "0.6.2-alpha",
  "description": "A writing app with spatial canvas boards",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "bundle": "esbuild src/renderer/js/tiptap.bundle.entry.js --bundle --format=iife --global-name=Tiptap --outfile=src/renderer/js/tiptap.bundle.js --minify",
    "predist": "git rev-parse HEAD > src/build-sha.txt",
    "dist": "electron-builder --mac"
  },
  "build": {
    "appId": "com.wolf427.scriptum",
    "productName": "Scriptum",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.productivity"
    }
  },
  "dependencies": {
    "dictionary-de": "^3.0.0",
    "dictionary-en": "^4.0.0",
    "dictionary-en-gb": "^3.0.0",
    "dictionary-es": "^4.0.0",
    "dictionary-fr": "^3.0.0",
    "docx": "^9.6.1",
    "html-to-docx": "^1.8.0",
    "nspell": "^2.1.5"
  },
  "devDependencies": {
    "@tiptap/core": "^3.22.3",
    "@tiptap/extension-placeholder": "^3.22.3",
    "@tiptap/extension-text-align": "^3.22.3",
    "@tiptap/extension-underline": "^3.22.3",
    "@tiptap/starter-kit": "^3.22.3",
    "electron": "^31.0.0",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.0"
  }
}
